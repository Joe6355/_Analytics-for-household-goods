    font-weight: 600;
}
QLabel[role=&quot;featuredFigure&quot;] {
    color: #244c54;
    font-size: 29px;
    font-weight: 650;
}
QFrame[role=&quot;rule&quot;] {
    background: #d1d9d5;
    border: none;
    min-height: 1px;
    max-height: 1px;
}
QFrame[role=&quot;sheet&quot;] {
    background: #fbfcfa;
    border: 1px solid #cbd5d1;
    border-radius: 2px;
}
QLabel#demoNote {
    color: #5e6a64;
    font-size: 9pt;
    border-top: 1px solid #d1d9d5;
    padding-top: 6px;
}
QLineEdit, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #becac5;
    border-radius: 2px;
    padding: 4px 7px;
    selection-background-color: #325c63;
}
QLineEdit:focus, QPlainTextEdit:focus {
    border-color: #3d6a70;
}
QComboBox, QSpinBox {
    min-height: 25px;
}
QPushButton {
    background: #fafbf8;
    color: #26383e;
    border: 1px solid #bac7c2;
    border-radius: 2px;
    padding: 6px 13px;
}
QPushButton:hover, QPushButton:focus {
    background: #e5ece8;
    border-color: #729291;
}
QPushButton[role=&quot;primary&quot;] {
    background: #2b555d;
    border-color: #2b555d;
    color: #ffffff;
}
QPushButton[role=&quot;primary&quot;]:hover, QPushButton[role=&quot;primary&quot;]:focus {
    background: #234850;
    border-color: #234850;
}
QPushButton:disabled {
    background: #edf0ed;
    border-color: #d3dbd5;
    color: #66726d;
}
QTableWidget {
    background: #fbfcfa;
    alternate-background-color: #f0f4f1;
    border: 1px solid #cbd5d1;
    gridline-color: #e1e7e2;
    selection-background-color: #dbe9e5;
    selection-color: #24383d;
}
QTableWidget::item {
    padding-left: 7px;
    padding-right: 7px;
}
QHeaderView::section {
