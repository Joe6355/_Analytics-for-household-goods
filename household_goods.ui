    font-weight: 600;
}
QListWidget#sectionList {
    background: transparent;
    border: 0;
    outline: 0;
}
QListWidget#sectionList::item {
    min-height: 38px;
    padding: 0 9px 0 12px;
    border-left: 3px solid transparent;
    color: #e0e5e6;
}
QListWidget#sectionList::item:hover {
    background: #2d3a42;
}
QListWidget#sectionList::item:selected {
    background: #35454e;
    border-left-color: #dba175;
    color: #ffffff;
}
QFrame#workspace {
    background: #f2f3f0;
}
QLabel[role=&quot;pageTitle&quot;] {
    color: #202d34;
    font-size: 28px;
    font-weight: 650;
}
QLabel[role=&quot;sectionTitle&quot;] {
    color: #26373e;
    font-size: 15px;
    font-weight: 600;
}
QLabel[role=&quot;muted&quot;] {
    color: #596762;
}
