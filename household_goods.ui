}
QLabel[role=&quot;value&quot;] {
    color: #244e76;
    font-size: 18px;
    font-weight: 600;
}
QTabWidget::pane {
    border: 1px solid #cbd3dc;
    background: #f5f7f9;
}
QTabBar::tab {
    background: #e5eaf0;
    border: 1px solid #cbd3dc;
    border-bottom: none;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    color: #334454;
    padding: 7px 14px;
    margin-right: 3px;
}
QTabBar::tab:selected {
    background: #f5f7f9;
    border-top: 2px solid #3b638a;
    color: #173d62;
}
QGroupBox {
    background: white;
    border: 1px solid #d4dbe3;
    border-radius: 4px;
    margin-top: 10px;
    padding: 8px 4px 4px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 9px;
    padding: 0 4px;
    color: #283b4e;
}
QGroupBox QWidget {
    font-weight: normal;
}
QLineEdit, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #bcc8d4;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #315d87;
}
QLineEdit:focus, QPlainTextEdit:focus {
    border-color: #3b638a;
}
QPushButton {
    background: #eef2f6;
    border: 1px solid #bec9d5;
    border-radius: 3px;
    color: #253748;
    padding: 5px 12px;
}
QPushButton:hover, QPushButton:focus {
    background: #e4edf5;
    border-color: #6c8aa7;
}
QPushButton[role=&quot;primary&quot;] {
    background: #315d87;
    border-color: #315d87;
    color: white;
}
QPushButton[role=&quot;primary&quot;]:hover, QPushButton[role=&quot;primary&quot;]:focus {
    background: #264e75;
    border-color: #264e75;
}
QTableWidget {
    background: white;
    alternate-background-color: #f5f7fa;
    border: 1px solid #ccd6e0;
    gridline-color: #e0e6ed;
    selection-background-color: #dce8f3;
    selection-color: #1d3a56;
}
QHeaderView::section {
    background: #e9eef4;
    border: none;
    border-right: 1px solid #d4dee9;
    border-bottom: 1px solid #ccd6e0;
    color: #273c51;
    padding: 5px 7px;
}</string>
